# Tush Wallet SEP-2 Federation & @tag Backend Environment Variables
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
DB_PATH=./data/tags.db

# Domain used in name*domain SEP-2 federation responses (auto-detected on Render/Railway if omitted)
FEDERATION_DOMAIN=tush.stellar

# Public HTTPS URL of this backend (auto-detected on Render/Railway if omitted)
PUBLIC_URL=https://tush-backend.onrender.com

# Comma-separated frontend origins allowed to call /lookup and /register (* allows all web/extension origins)
CORS_ORIGINS=*
TRUST_PROXY=1
MAX_TAGS_PER_ADDRESS=3
