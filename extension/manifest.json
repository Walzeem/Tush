{
  "manifest_version": 3,
  "name": "Tush Wallet — Stellar & @tag Smart Wallet",
  "short_name": "Tush Wallet",
  "version": "1.0.0",
  "description": "Self-custodial Stellar & Soroban wallet with universal @tag usernames, SEP-5 recovery phrases, Passkey vault, and SEP-43 dApp provider.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tush Wallet",
    "default_popup": "index.html?mode=popup#dashboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?mode=sidepanel#dashboard"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://tush-backend-h586.onrender.com/*",
    "https://horizon-testnet.stellar.org/*",
    "https://soroban-testnet.stellar.org/*",
    "https://friendbot.stellar.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage-provider.js",
        "favicon.svg",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}

