# Port and host for the tag server (avoid 5000 on Windows/macOS where Docker/AirPlay may bind it)
PORT=4000
HOST=0.0.0.0

# SQLite database file path (created automatically)
DB_PATH=./data/tags.db

# Domain part of federation addresses: <username>*<FEDERATION_DOMAIN>
# Must be set to your real domain in production (e.g. tush.app)
FEDERATION_DOMAIN=localhost

# Optional public base URL used in /.well-known/stellar.toml (defaults to request host)
PUBLIC_URL=

# Comma-separated frontend origins allowed to call /register and /lookup
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Maximum number of tags a single Stellar address can claim
MAX_TAGS_PER_ADDRESS=3

